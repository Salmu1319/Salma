<div class="event-card">

  {% if fields.field_event_image is defined %}
    <div class="event-image">
      {{ fields.field_event_image.content }}
    </div>
  {% endif %}
{% if fields.field_event_date is defined %}
      <p class="event-date">{{ fields.field_event_date.content }}</p>
    {% endif %}
  <div class="event-info">

    {% if fields.title is defined %}
      <h3 class="event-title">{{ fields.title.content }}</h3>
    {% endif %}

    

  </div>

</div>
